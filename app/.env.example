# Copy to .env.local and fill in from Supabase: Project Settings > API.
# Leave both empty to run on the built-in sample data from index.html.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Optional Google Maps JavaScript API browser key and map ID.
VITE_GOOGLE_MAPS_API_KEY=
VITE_GOOGLE_MAPS_MAP_ID=

# Optional server secret for Helena.
GEMINI_API_KEY=
