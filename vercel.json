{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/:path((?!api/).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/ask.mjs": { "maxDuration": 25 }
  },
  "framework": "vite",
  "installCommand": "npm --prefix app ci",
  "buildCommand": "npm --prefix app run build",
  "outputDirectory": "app/dist"
}
